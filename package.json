{
  "name": "charis-study",
  "version": "1.0.0",
  "private": true,
  "description": "Charis Study \u2014 break any notes, PDF or topic into bite-size chunks and remember them with flashcards, spaced repetition, quizzes, memory palace, mnemonics and more.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server.js",
    "start": "node server.js",
    "typecheck": "tsc --noEmit && node scripts/check-effects.mjs",
    "test:engine": "tsx scripts/engine-smoke.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.0",
    "knex": "^3.1.0",
    "zod": "^4.1.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.540.0",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "main": "server.js"
}

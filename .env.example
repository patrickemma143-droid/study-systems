# ─── Charis Study configuration ───────────────────────────────
# Copy this file to ".env" and change the values.

# Port the API (and, in production, the whole app) listens on
PORT=8787

# Secret used to sign login sessions. Use a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Database: "sqlite" (default, zero setup) or "mysql" (e.g. Hostinger MySQL).
# If DB_USER / MYSQL_USER or DATABASE_URL is set, MySQL is used automatically.
# DB_CLIENT=sqlite
# SQLITE_FILE=./data/charis-study.db

# MySQL (Hostinger: host is localhost, port 3306). Either these…
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# …or one URL:
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# Set to "true" when the site is served over HTTPS (production)
COOKIE_SECURE=false

# Contact used in the User-Agent for Wikipedia requests (their policy asks for one)
CONTACT_EMAIL=hello@chariscreations.com

# ─── Future: AI upgrade (not used yet — the app is API-free) ───
# AI_PROVIDER=none   # later: gemini | claude
# AI_API_KEY=

# Optional: folder for the SQLite database and session secret.
# On Hostinger this defaults to <your domain folder>/charis-data so data survives redeploys.
# DATA_DIR=

# ─── Charis Study configuration ───────────────────────────────
# Copy this file to ".env" and change the values.

# Port the API (and, in production, the whole app) listens on
PORT=3000

# Secret used to sign login sessions. Use a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Database: "sqlite" (default, zero setup) or "mysql" (e.g. Hostinger MySQL).
# If DB_USER / MYSQL_USER or DATABASE_URL is set, MySQL is used automatically.
# DB_CLIENT=sqlite
# SQLITE_FILE=./data/charis-study.db

# MySQL (Hostinger: host is localhost, port 3306). Either these…
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# …or one URL:
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# Set to "true" when the site is served over HTTPS (production)
COOKIE_SECURE=false

# Contact used in the User-Agent for Wikipedia requests (their policy asks for one)
CONTACT_EMAIL=hello@chariscreations.com

# ─── Optional AI helpers (the app works fully without them) ───
# Add ONE key to switch on: explain-it-simply, tutor chat, AI marking.
# Gemini key: https://aistudio.google.com/apikey  (turn on billing before real student data:
# on the free tier Google may use what you send to improve its products)
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini            # gemini | claude | mock (fake answers, testing only)
# AI_MODEL=gemini-3.5-flash-lite
# Daily allowance per student (shared answers from classmates don't count)
# AI_LIMITS_FREE=simplify=10,tutor=5,feedback=3
# AI_LIMITS_PRO=simplify=200,tutor=60,feedback=30
# Who can open /admin (comma-separated login emails). Admins always get Pro.
# ADMIN_EMAILS=you@example.com
# When "today" starts for allowances: hours ahead of UTC (Kampala = 3)
# TZ_OFFSET_HOURS=3

# Optional: folder for the SQLite database and session secret.
# On Hostinger this defaults to <your domain folder>/charis-data so data survives redeploys.
# DATA_DIR=

# ─── Reminders (web push) ───
# Keys are created automatically and saved in the database. Set these only to use fixed keys.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# REMINDERS_OFF=true   # stop sending reminders

# Your public web address, used in public profile links and the sitemap (set once you have a domain)
# PUBLIC_URL=https://study.chariscreations.com
